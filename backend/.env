# ===========================================
# SynapseAI Backend - Environment Variables
# ===========================================

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/SynapseAI

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_to_something_very_long_and_random_in_production
JWT_EXPIRE=7d

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password-from-google
EMAIL_FROM=SynapseAI <noreply@synapseai.com>

# Google OAuth 2.0 (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID=329998824011-e04cqb5glqjf8e61m43svetu19vvui46.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Server Configuration
PORT=5000
NODE_ENV=development

# ===========================================
# Production Settings (when deploying)
